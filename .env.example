# ──────────────────────────────────────────────
# Deployment (docker-compose & deploy scripts)
# ──────────────────────────────────────────────
ECR_IMAGE=public.ecr.aws/<AWS_ACCOUNT_ID>/<ECR_REPO_NAME>
MAKERS_BACKEND_BLUE_PORT=8081
MAKERS_BACKEND_GREEN_PORT=8082

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER_CLASS=
JPA_DDL_AUTO=

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
ACCESS_TOKEN_EXPIRATION_TIME=
REFRESH_TOKEN_EXPIRATION_TIME=
JWT_SECRET_KEY=

# ──────────────────────────────────────────────
# Security / API Keys
# ──────────────────────────────────────────────
MONITORING_X_API_KEY=
DEVELOPER_API_KEY=
ACTUATOR_PATH=/actuator

# ──────────────────────────────────────────────
# Auth (bypass login)
# ──────────────────────────────────────────────
BYPASS_LOGIN_PHONE=
BYPASS_LOGIN_CODE=
BYPASS_LOGIN_NAME=

# ──────────────────────────────────────────────
# OAuth
# ──────────────────────────────────────────────
APPLE_OAUTH_WEB_AUD=
APPLE_OAUTH_APP_AUD=
GOOGLE_OAUTH_CLIENT_ID=

# ──────────────────────────────────────────────
# SMS (Gabia)
# ──────────────────────────────────────────────
GABIA_SMS_ID=
GABIA_API_KEY=
GABIA_SENDER_NUMBER=

# ──────────────────────────────────────────────
# Playground
# ──────────────────────────────────────────────
PLAYGROUND_URL=
PLAYGROUND_TOKEN=
PLAYGROUND_POST_REFRESH_SCHEDULER_ENABLED=false

# ──────────────────────────────────────────────
# AWS S3
# ──────────────────────────────────────────────
S3_BUCKET=
S3_REGION=
S3_BASE_DIR=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ──────────────────────────────────────────────
# Alarm Notification
# ──────────────────────────────────────────────
ALARM_NOTIFICATION_URL=
ALARM_NOTIFICATION_KEY=
ALARM_NOTIFICATION_ARN=

# ──────────────────────────────────────────────
# AWS EventBridge
# ──────────────────────────────────────────────
AWS_EVENTBRIDGE_ROLE_ARN=
AWS_REGION=

# ──────────────────────────────────────────────
# Auth API (homepage activities count)
# ──────────────────────────────────────────────
AUTH_API_URL=
AUTH_API_KEY=
AUTH_SERVICE_NAME=

# ──────────────────────────────────────────────
# Crew API (homepage study count)
# ──────────────────────────────────────────────
CREW_API_URL=

# ──────────────────────────────────────────────
# Official (외부 배너 조회용 api-key)
# ──────────────────────────────────────────────
OFFICIAL_API_KEY=

# 현재 기수. 기수 전환 때 바꾸고 재배포한다
SOPT_CURRENT_GENERATION=

# 솝탬프 어드민 운영 API 비밀번호. /api/v2/admin/soptamp 와 /api/v2/admin/schedule 이 이 값 하나로 막힌다.
# 비워 두면 두 경로가 어떤 비밀번호로도 통과하지 않는다
SOPTAMP_ADMIN_PASSWORD=

# 앱잼탬프 시즌이면 true. 랭킹 캐시 동기화와 박수 알림, upsert 배치가 이 값으로 갈린다
SOPTAMP_APPJAM_MODE=false

# 솝탬프 스케줄러 온오프. 구서버와 함께 떠 있는 전환 기간에는 둘 다 꺼 두고 어드민 수동 실행만 쓴다
SOPTAMP_RANK_RELOAD_SCHEDULER_ENABLED=false
SOPTAMP_UPSERT_SCHEDULER_ENABLED=false
APP_IS_AVAILABLE=true
